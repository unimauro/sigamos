# Capa de IA opcional del chat de acompañamiento (gateway ai.tunky.net).
# Sin estas variables, el chat funciona en modo guiado (recomendado por defecto).
# NO commitees tu .env real (está en .gitignore).

# Token del gateway (pedir a Carlos). El gateway lo protege con allowlist de Origin.
VITE_TUNKY_TOKEN=

# Endpoint del gateway. Opcional; este es el valor por defecto.
# VITE_TUNKY_GATEWAY=https://ai.tunky.net/v1/chat

# Analítica sin cookies y anónima (GoatCounter). Opcional.
# Crea tu sitio gratis en https://www.goatcounter.com y pon aquí su URL de conteo.
# Sin esta variable no se carga ninguna analítica.
# VITE_GOATCOUNTER=https://sigamos.goatcounter.com/count
